---
interface Tag {
  icon: string;
  label: string;
  color?: 'copper' | 'blue' | 'emerald' | 'amber';
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  tags: Tag[];
  title: string;
  highlight?: string;
  subtitle: string;
  primaryCta?: { label: string; href: string; icon?: string };
  secondaryCta?: { label: string; href: string; icon?: string; external?: boolean };
  stats: Stat[];
}

const {
  tags,
  title,
  highlight,
  subtitle,
  primaryCta = { label: 'Ver Análisis', href: '#analisis', icon: 'fa-arrow-down' },
  secondaryCta = { label: 'Otros Proyectos', href: '/portafolio/', icon: 'fa-arrow-left' },
  stats,
} = Astro.props;

const tagColorMap = {
  copper: 'border-copper-400/35 bg-copper-500/15 text-copper-300',
  blue: 'border-sky-400/35 bg-sky-500/15 text-sky-300',
  emerald: 'border-emerald-400/35 bg-emerald-500/15 text-emerald-300',
  amber: 'border-amber-400/35 bg-amber-500/15 text-amber-300',
};
---

<section class="relative overflow-hidden bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-16 sm:pt-36 sm:pb-20 text-white">
  <div id="particles-js" class="absolute inset-0 z-[1]"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(circle_at_75%_25%,rgba(200,117,51,0.18)_0%,transparent_50%),radial-gradient(circle_at_15%_80%,rgba(59,130,246,0.12)_0%,transparent_45%)]"
  ></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="flex flex-wrap justify-center lg:justify-start gap-2.5 mb-6">
          {tags.map((tag) => (
            <span
              class={`inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-xs font-mono font-semibold backdrop-blur-sm ${tagColorMap[tag.color ?? 'blue']}`}
            >
              <i class={tag.icon} aria-hidden="true"></i>
              {tag.label}
            </span>
          ))}
        </div>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.1] mb-5">
          {title}
          {highlight && <span class="block text-copper-gradient mt-1">{highlight}</span>}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-8">
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-3.5">
          <a
            href={primaryCta.href}
            class="btn-enterprise-primary inline-flex items-center justify-center gap-2 min-h-12 rounded-xl px-6 py-3 text-sm sm:text-base font-semibold"
          >
            {primaryCta.icon && <i class={`fas ${primaryCta.icon} text-xs`} aria-hidden="true"></i>}
            {primaryCta.label}
          </a>
          <a
            href={secondaryCta.href}
            target={secondaryCta.external ? '_blank' : undefined}
            rel={secondaryCta.external ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center justify-center gap-2 min-h-12 rounded-xl border border-white/25 bg-white/10 px-6 py-3 text-sm sm:text-base font-semibold text-white backdrop-blur-md transition-all hover:bg-white/15 hover:border-copper-400/60 active:scale-[0.98]"
          >
            {secondaryCta.icon && <i class={`fas ${secondaryCta.icon} text-xs`} aria-hidden="true"></i>}
            {secondaryCta.label}
          </a>
        </div>
      </div>

      <!-- Right Glassmorphic 2x2 Stats Bento -->
      <div class="lg:col-span-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {stats.map((stat) => (
            <div class="rounded-2xl border border-white/15 bg-white/[0.08] p-5 text-center backdrop-blur-xl shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:bg-white/[0.12]">
              <div class="font-mono text-2xl sm:text-3xl font-bold text-amber-400 mb-1.5">{stat.value}</div>
              <div class="text-xs sm:text-sm text-slate-200 font-medium leading-snug">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
