---
const services = [
  {
    num: '01',
    title: 'Analítica y Ciencia de Datos',
    description: 'Convertimos tus datos en conocimiento accionable para tomar mejores decisiones.',
    meta: '10 días · 3–6 sem.',
    items: [
      'Modelos Predictivos y Machine Learning',
      'Segmentación y Análisis Avanzado',
      'Arquitectura y Preparación de Datos',
      'Auditoría de Madurez Analítica',
    ],
    modalId: 'modal-analytics',
    portfolioHref: '/portafolio/pensiones/',
  },
  {
    num: '02',
    title: 'Control de Gestión y Procesos',
    description: 'Diseñamos y mejoramos el desempeño de tu operación para aumentar su eficiencia.',
    meta: 'AS-IS / TO-BE · 2–4 sem.',
    items: [
      'Sistemas de Control de Gestión',
      'Mapeo y Rediseño de Procesos (AS-IS / TO-BE)',
      'Gestión por Indicadores y KPIs',
      'Estandarización y Documentación Operativa',
    ],
    modalId: 'modal-processes',
    portfolioHref: '/portafolio/pesquera/',
  },
  {
    num: '03',
    title: 'Simulación y Optimización',
    description: 'Evaluamos escenarios operacionales antes de invertir para optimizar tus recursos.',
    meta: 'SIMIO · 3–5 sem.',
    items: [
      'Optimización Matemática de Recursos',
      'Simulación de Sistemas y Escenarios',
      'Optimización Logística y Network Design',
      'Modelos Estocásticos de Inventarios',
    ],
    modalId: 'modal-simulation',
    portfolioHref: '/portafolio/simulacion/',
  },
  {
    num: '04',
    title: 'Sistemas Digitales y Automatización',
    description: 'Desarrollamos aplicaciones web a medida, tableros BI e integraciones de negocio.',
    meta: 'Web & BI · 2–6 sem.',
    items: [
      'Aplicaciones Web y Portales a Medida',
      'Business Intelligence y Visualización Ejecutiva',
      'Automatización de Reportes y Flujos',
      'Integración de Sistemas y APIs',
    ],
    modalId: 'modal-digital',
    portfolioHref: '/portafolio/mini-erp/',
  },
];
---

<section id="servicios" class="py-20 bg-white border-b border-slate-200 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 border-b border-slate-200 mb-10">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-2">
          03 — Capacidades
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900">
          Servicios
        </h2>
      </div>
      <p class="text-slate-600 text-sm sm:text-base max-w-md">
        Soluciones integrales diseñadas a la medida de tu empresa, desde la estrategia hasta la implementación operativa.
      </p>
    </div>

    <!-- Swiss 2x2 Continuous 1px Hairline Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-200 bg-slate-200 gap-px">
      {services.map((service) => (
        <article class="group bg-white p-8 sm:p-10 flex flex-col justify-between transition-colors hover:bg-slate-50/70">
          <div>
            <div class="flex items-center justify-between gap-4 pb-4 mb-5 border-b border-slate-100">
              <span class="font-mono text-xs font-bold uppercase tracking-widest text-copper-500">
                {service.num} / CAPACIDAD
              </span>
              <span class="font-mono text-[11px] font-medium text-slate-500">
                {service.meta}
              </span>
            </div>

            <h3 class="font-display text-2xl font-bold text-navy-900 mb-2.5">{service.title}</h3>
            <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed">{service.description}</p>

            <ul class="space-y-2 mb-8">
              {service.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                  <span class="font-mono text-copper-500 text-xs mt-0.5 shrink-0" aria-hidden="true">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-slate-100 flex items-center justify-between gap-4">
            <button
              type="button"
              data-modal={service.modalId}
              class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-600 hover:text-copper-600 transition-colors cursor-pointer py-2"
            >
              + Ver alcance
            </button>
            <a
              href={service.portfolioHref}
              class="group/btn btn-enterprise-navy min-h-10 inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold"
            >
              Caso relacionado
              <i class="fas fa-arrow-right text-[10px] transition-transform duration-200 group-hover/btn:translate-x-1" aria-hidden="true"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
