---
const services = [
  {
    num: '01',
    icon: 'fa-brain',
    title: 'Analítica y Ciencia de Datos',
    description: 'Convertimos tus datos en conocimiento accionable para tomar mejores decisiones.',
    meta: '10 días · 3–6 sem.',
    items: [
      'Modelos Predictivos y Machine Learning',
      'Segmentación y Análisis Avanzado',
      'Arquitectura y Preparación de Datos',
      'Auditoría de Madurez Analítica',
    ],
    modalId: 'modal-analytics',
    portfolioHref: '/portafolio/pensiones/',
    visual: 'curve',
  },
  {
    num: '02',
    icon: 'fa-cogs',
    title: 'Control de Gestión y Procesos',
    description: 'Diseñamos y mejoramos el desempeño de tu operación para aumentar su eficiencia.',
    meta: 'AS-IS / TO-BE · 2–4 sem.',
    items: [
      'Sistemas de Control de Gestión',
      'Mapeo y Rediseño de Procesos (AS-IS / TO-BE)',
      'Gestión por Indicadores y KPIs',
      'Estandarización y Documentación Operativa',
    ],
    modalId: 'modal-processes',
    portfolioHref: '/portafolio/pesquera/',
    visual: 'bars',
  },
  {
    num: '03',
    icon: 'fa-map-marked-alt',
    title: 'Simulación y Optimización',
    description: 'Evaluamos escenarios operacionales antes de invertir para optimizar tus recursos.',
    meta: 'SIMIO · 3–5 sem.',
    items: [
      'Optimización Matemática de Recursos',
      'Simulación de Sistemas y Escenarios',
      'Optimización Logística y Network Design',
      'Modelos Estocásticos de Inventarios',
    ],
    modalId: 'modal-simulation',
    portfolioHref: '/portafolio/simulacion/',
    visual: 'nodes',
  },
  {
    num: '04',
    icon: 'fa-laptop-code',
    title: 'Sistemas Digitales y Automatización',
    description: 'Desarrollamos aplicaciones web a medida, tableros BI e integraciones de negocio.',
    meta: 'Web & BI · 2–6 sem.',
    items: [
      'Aplicaciones Web y Portales a Medida',
      'Business Intelligence y Visualización Ejecutiva',
      'Automatización de Reportes y Flujos',
      'Integración de Sistemas y APIs',
    ],
    modalId: 'modal-digital',
    portfolioHref: '/portafolio/mini-erp/',
    visual: 'window',
  },
];
---

<section id="servicios" class="py-20 bg-slate-100/80 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block rounded-full bg-copper-500/10 border border-copper-500/25 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-copper-500 mb-3">
        Qué Hacemos
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900 mb-3">
        Servicios
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Soluciones integrales diseñadas a la medida de tu empresa, desde la estrategia hasta la implementación operativa.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service) => (
        <article class="group relative overflow-hidden rounded-2xl border border-slate-200/90 ring-1 ring-navy-900/[0.04] bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-copper-500/40 flex flex-col">
          <!-- Subtle Copper Hover Radial Glow -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-copper-500/10 opacity-0 blur-2xl transition-opacity duration-300 group-hover:opacity-100"
          ></div>

          <!-- Top Header: Number + Icon + Mini Visual -->
          <div class="relative flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center gap-3.5">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-navy-900 text-copper-400 text-lg shadow-sm transition-transform duration-300 group-hover:scale-105">
                <i class={`fas ${service.icon}`} aria-hidden="true"></i>
              </div>
              <div>
                <span class="font-mono text-[11px] font-bold uppercase tracking-widest text-copper-500 block">
                  Servicio {service.num}
                </span>
                <span class="inline-block rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-600 mt-0.5">
                  {service.meta}
                </span>
              </div>
            </div>

            <!-- Discipline Micro-Visual SVG -->
            <div class="hidden sm:flex h-12 w-20 items-center justify-center rounded-xl border border-slate-100 bg-slate-50/80 p-2 text-navy-900/70 group-hover:border-copper-500/25 group-hover:text-copper-500 transition-colors" aria-hidden="true">
              {service.visual === 'curve' && (
                <svg viewBox="0 0 64 28" class="w-full h-full fill-none stroke-current" stroke-width="2.2" stroke-linecap="round">
                  <path d="M4 22 C16 20, 22 10, 32 14 C42 18, 48 6, 60 4" />
                  <circle cx="60" cy="4" r="2.5" class="fill-copper-500 stroke-none" />
                </svg>
              )}
              {service.visual === 'bars' && (
                <svg viewBox="0 0 64 28" class="w-full h-full fill-current">
                  <rect x="6" y="16" width="8" height="10" rx="2" opacity="0.35" />
                  <rect x="19" y="10" width="8" height="16" rx="2" opacity="0.6" />
                  <rect x="32" y="13" width="8" height="13" rx="2" opacity="0.8" />
                  <rect x="45" y="4" width="8" height="22" rx="2" class="text-copper-500" />
                </svg>
              )}
              {service.visual === 'nodes' && (
                <svg viewBox="0 0 64 28" class="w-full h-full fill-none stroke-current" stroke-width="1.8">
                  <line x1="12" y1="14" x2="32" y2="6" opacity="0.5" />
                  <line x1="12" y1="14" x2="32" y2="22" opacity="0.5" />
                  <line x1="32" y1="6" x2="52" y2="14" opacity="0.5" />
                  <line x1="32" y1="22" x2="52" y2="14" opacity="0.5" />
                  <circle cx="12" cy="14" r="3.5" class="fill-white" />
                  <circle cx="32" cy="6" r="3.5" class="fill-white" />
                  <circle cx="32" cy="22" r="3.5" class="fill-white" />
                  <circle cx="52" cy="14" r="4" class="fill-copper-500 stroke-none" />
                </svg>
              )}
              {service.visual === 'window' && (
                <svg viewBox="0 0 64 28" class="w-full h-full fill-none stroke-current" stroke-width="1.8">
                  <rect x="6" y="3" width="52" height="22" rx="4" opacity="0.5" />
                  <line x1="6" y1="10" x2="58" y2="10" opacity="0.4" />
                  <circle cx="12" cy="6.5" r="1.2" class="fill-copper-500 stroke-none" />
                  <circle cx="17" cy="6.5" r="1.2" class="fill-current stroke-none" opacity="0.5" />
                  <rect x="12" y="14" width="22" height="6" rx="1.5" class="fill-copper-500/20 stroke-none" />
                </svg>
              )}
            </div>
          </div>

          <h3 class="font-display text-xl font-bold text-navy-900 mb-2">{service.title}</h3>
          <p class="text-slate-600 text-sm sm:text-base mb-5">{service.description}</p>

          <ul class="space-y-2 mb-7 flex-1">
            {service.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-copper-500 shrink-0" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- Clear Visual Hierarchy: Soft Ghost + Primary Navy Action -->
          <div class="pt-5 border-t border-slate-100 flex items-center gap-3">
            <button
              type="button"
              data-modal={service.modalId}
              class="btn-enterprise-ghost min-h-11 rounded-xl px-4 py-2.5 text-sm font-semibold cursor-pointer"
            >
              Ver Detalles
            </button>
            <a
              href={service.portfolioHref}
              class="group/btn btn-enterprise-navy flex-1 min-h-11 inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold"
            >
              Ver Portafolio
              <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover/btn:translate-x-1" aria-hidden="true"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
