---
const testimonials = [
  {
    quote:
      '"Con InnerData logramos llevar la operación de Aukabox a una plataforma web clara y rápida. Hoy nuestros clientes en Chillán y todo Chile entienden el flujo de su casilla en Miami y cotizan compras asistidas sin fricción."',
    initials: 'RO',
    name: 'Rodolfo Osses Z.',
    role: 'Aukabox · www.aukabox.cl',
    href: '/portafolio/aukabox/',
  },
  {
    quote:
      '"Normalizar nuestros indicadores ASG y huella hídrica nos dio visibilidad real de la planta. Pasamos de datos dispersos a una hoja de ruta priorizada con métricas comparables por tonelada producida."',
    initials: 'GO',
    name: 'G. Onate',
    role: 'Empresa Pesquero-Industrial',
    href: '/portafolio/pesquera/',
  },
];
---

<section id="testimonios" class="py-20 bg-white reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block rounded-full bg-copper-500/10 border border-copper-500/25 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-copper-500 mb-3">
        Confianza
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900">
        Lo que dicen nuestros clientes
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {testimonials.map((t) => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-copper-500/35 flex flex-col justify-between">
          <div>
            <i class="fas fa-quote-left text-2xl text-copper-500/40 mb-4 block" aria-hidden="true"></i>
            <p class="text-slate-700 italic leading-relaxed mb-6">{t.quote}</p>
          </div>
          <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-200/80">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-navy-900 to-copper-500 text-sm font-bold text-white">
                {t.initials}
              </div>
              <div>
                <h3 class="font-display text-sm font-bold text-navy-900">{t.name}</h3>
                <p class="text-xs text-slate-500">{t.role}</p>
              </div>
            </div>
            <a href={t.href} class="text-xs font-semibold text-copper-600 hover:text-copper-500 transition-colors shrink-0">
              Ver caso →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
