---
const testimonials = [
  {
    quote:
      '“Con InnerData logramos llevar la operación de Aukabox a una plataforma web clara y rápida. Hoy nuestros clientes en Chillán y todo Chile entienden el flujo de su casilla en Miami y cotizan compras asistidas sin fricción.”',
    name: 'Rodolfo Osses Z.',
    role: 'Aukabox · www.aukabox.cl',
    href: '/portafolio/aukabox/',
  },
  {
    quote:
      '“Normalizar nuestros indicadores ASG y huella hídrica nos dio visibilidad real de la planta. Pasamos de datos dispersos a una hoja de ruta priorizada con métricas comparables por tonelada producida.”',
    name: 'G. Onate',
    role: 'Empresa Pesquero-Industrial',
    href: '/portafolio/pesquera/',
  },
];
---

<section id="testimonios" class="py-20 bg-slate-50 border-b border-slate-200 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 border-b border-slate-200 mb-10">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-2">
          05 — Clientes
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900">
          Lo que dicen nuestros clientes
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-200 bg-slate-200 gap-px">
      {testimonials.map((t) => (
        <article class="bg-white p-8 sm:p-10 flex flex-col justify-between">
          <p class="font-display text-lg sm:text-xl text-navy-900 leading-relaxed mb-8">
            {t.quote}
          </p>
          <div class="flex items-center justify-between gap-4 pt-5 border-t border-slate-100">
            <div>
              <h3 class="font-display text-sm font-bold text-navy-900">{t.name}</h3>
              <p class="font-mono text-xs text-slate-500 mt-0.5">{t.role}</p>
            </div>
            <a href={t.href} class="font-mono text-xs font-semibold text-copper-600 hover:text-copper-500 transition-colors shrink-0">
              Ver caso →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
