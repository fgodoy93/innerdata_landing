---
const groups = [
  {
    code: '01',
    label: 'Ciencia de Datos, ML & Visualización',
    items: ['Python', 'Pandas', 'NumPy', 'Scikit-learn', 'TensorFlow', 'SciPy', 'Matplotlib', 'Seaborn', 'R Studio'],
  },
  {
    code: '02',
    label: 'Desarrollo Web, Datos & Cloud',
    items: ['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Astro', 'Node.js', 'SQL & PostgreSQL', 'Cloudflare', 'AWS Cloud'],
  },
  {
    code: '03',
    label: 'Business Intelligence & Simulación',
    items: ['Power BI', 'Looker Studio', 'Simio Simulation', 'Microsoft Visio'],
  },
];
---

<section class="py-16 bg-slate-50 border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-6 border-b border-slate-200 mb-8">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-1">
          Stack Técnico
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900">
          Tecnologías que dominamos
        </h2>
      </div>
      <span class="font-mono text-xs text-slate-500">22 herramientas en producción</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border border-slate-200 bg-slate-200 gap-px">
      {groups.map((group) => (
        <div class="bg-white p-6 sm:p-7">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <h3 class="font-display text-sm font-bold text-navy-900">{group.label}</h3>
            <span class="font-mono text-[11px] text-copper-500 font-semibold">{group.code}</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((name) => (
              <span class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 font-mono text-xs font-medium text-navy-900 hover:border-copper-500/50 transition-colors">
                {name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
