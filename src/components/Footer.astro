---
interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;
const prefix = isHome ? '' : '/';
---

<footer class="mt-auto bg-navy-900 text-slate-300 border-t border-white/10">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5 text-2xl font-extrabold text-white font-display mb-4">
          <span>Inner<span class="text-copper-400">Data</span></span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm mb-6">
          Analítica avanzada, ingeniería de procesos y desarrollo de sistemas digitales para organizaciones que toman decisiones basadas en evidencia.
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://www.linkedin.com/company/innerdatacl/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn de InnerData"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-slate-300 transition-colors hover:border-copper-400 hover:text-copper-400"
          >
            <i class="fab fa-linkedin text-lg" aria-hidden="true"></i>
          </a>
          <a
            href="mailto:contacto@innerdata.cl"
            aria-label="Enviar correo a InnerData"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-slate-300 transition-colors hover:border-copper-400 hover:text-copper-400"
          >
            <i class="fas fa-envelope text-lg" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div>
          <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white mb-4">Servicios</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/servicios/" class="hover:text-white transition-colors">Analítica de Datos</a></li>
            <li><a href="/servicios/" class="hover:text-white transition-colors">Control de Gestión</a></li>
            <li><a href="/servicios/" class="hover:text-white transition-colors">Simulación y Optimización</a></li>
            <li><a href="/servicios/" class="hover:text-white transition-colors">Sistemas Digitales</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white mb-4">Compañía</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/nosotros/" class="hover:text-white transition-colors">Quiénes Somos</a></li>
            <li><a href="/portafolio/" class="hover:text-white transition-colors">Portafolio</a></li>
            <li><a href="/contacto/" class="hover:text-white transition-colors">Contacto</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white mb-4">Contacto</h4>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="mailto:contacto@innerdata.cl" class="hover:text-copper-400 transition-colors">contacto@innerdata.cl</a>
            </li>
            <li class="text-slate-400">Chile · Consultoría Remota & Presencial</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; 2026 InnerData. Todos los derechos reservados.</p>
      <p class="font-mono text-slate-500">Ingeniería · Analítica · Optimización</p>
    </div>
  </div>
</footer>
