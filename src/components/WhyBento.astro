---
const pillars = [
  {
    num: '01',
    title: 'Resultados Tangibles',
    desc: 'Cada proyecto se estructura en torno a indicadores operativos y financieros verificables, sin entregables abstractos.',
    tag: 'KPIs & ROI',
  },
  {
    num: '02',
    title: 'Confidencialidad Total',
    desc: 'Operamos bajo acuerdos NDA estrictos y estándares rigurosos de gobierno, acceso mínimo y resguardo de datos.',
    tag: 'NDA & Gobierno',
  },
  {
    num: '03',
    title: 'Socios, no Proveedores',
    desc: 'Nos integramos en tu Slack, Teams y flujo de trabajo como un miembro más de tu equipo técnico.',
    tag: 'Equipo Integrado',
  },
  {
    num: '04',
    title: 'Enfoque End-to-End',
    desc: 'Conectamos diagnóstico de procesos, modelamiento matemático, BI y software a medida en una sola arquitectura.',
    tag: 'Medir → Simular → Escalar',
  },
];
---

<section class="py-20 bg-white border-b border-slate-200 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Editorial Left-Aligned Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 border-b border-slate-200 mb-10">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-2">
          01 — Nuestra Diferencia
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900">
          ¿Por qué InnerData?
        </h2>
      </div>
      <p class="text-slate-600 text-sm sm:text-base max-w-md">
        No somos otra consultora más. Somos ingenieros resolviendo problemas críticos de tu organización.
      </p>
    </div>

    <!-- Swiss 1px Hairline Architectural Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-200 bg-slate-200 gap-px">
      {pillars.map((item, idx) => (
        <div class={`p-8 sm:p-10 flex flex-col justify-between ${idx === 0 ? 'bg-navy-900 text-white' : 'bg-white text-navy-900'}`}>
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class={`font-mono text-xs font-bold tracking-widest ${idx === 0 ? 'text-copper-400' : 'text-copper-500'}`}>
                {item.num}
              </span>
              <span class={`font-mono text-[11px] uppercase tracking-wider px-2.5 py-0.5 border ${idx === 0 ? 'border-white/20 text-slate-300' : 'border-slate-200 text-slate-500'}`}>
                {item.tag}
              </span>
            </div>
            <h3 class={`font-display text-xl sm:text-2xl font-bold mb-3 ${idx === 0 ? 'text-white' : 'text-navy-900'}`}>
              {item.title}
            </h3>
            <p class={`text-sm sm:text-base leading-relaxed ${idx === 0 ? 'text-slate-300' : 'text-slate-600'}`}>
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
