---
interface Props {
  currentPage?: 'home' | 'about' | 'services' | 'portfolio' | 'contact';
}

const { currentPage = 'home' } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 h-20 bg-white/85 backdrop-blur-xl border-b border-slate-200/80 transition-all duration-300"
>
  <div class="mx-auto flex h-full max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2.5 text-2xl font-extrabold tracking-tight text-navy-900 font-display">
      <img src="/assets/logo.png" alt="InnerData Logo" class="h-10 w-auto" />
      <span>Inner<span class="text-copper-500">Data</span></span>
    </a>

    <button
      type="button"
      class="menu-toggle inline-flex md:hidden h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-navy-900 hover:border-copper-500 hover:text-copper-500 transition-colors cursor-pointer"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="primary-nav-links"
    >
      <i class="fas fa-bars text-lg" aria-hidden="true"></i>
    </button>

    <ul
      id="primary-nav-links"
      class="nav-links hidden md:flex items-center gap-7"
    >
      <li>
        <a
          href="/"
          aria-current={currentPage === 'home' ? 'page' : undefined}
          class={`text-sm font-medium transition-colors ${currentPage === 'home' ? 'text-navy-900 font-semibold' : 'text-slate-600 hover:text-navy-900'}`}
        >
          Inicio
        </a>
      </li>
      <li>
        <a
          href="/nosotros/"
          aria-current={currentPage === 'about' ? 'page' : undefined}
          class={`text-sm font-medium transition-colors ${currentPage === 'about' ? 'text-navy-900 font-semibold' : 'text-slate-600 hover:text-navy-900'}`}
        >
          Nosotros
        </a>
      </li>
      <li>
        <a
          href="/servicios/"
          aria-current={currentPage === 'services' ? 'page' : undefined}
          class={`text-sm font-medium transition-colors ${currentPage === 'services' ? 'text-navy-900 font-semibold' : 'text-slate-600 hover:text-navy-900'}`}
        >
          Servicios
        </a>
      </li>
      <li>
        <a
          href="/portafolio/"
          aria-current={currentPage === 'portfolio' ? 'page' : undefined}
          class={`text-sm font-medium transition-colors ${currentPage === 'portfolio' ? 'text-navy-900 font-semibold' : 'text-slate-600 hover:text-navy-900'}`}
        >
          Portafolio
        </a>
      </li>
      <li>
        <a
          href="/contacto/"
          aria-current={currentPage === 'contact' ? 'page' : undefined}
          class={`text-sm font-medium transition-colors ${currentPage === 'contact' ? 'text-navy-900 font-semibold' : 'text-slate-600 hover:text-navy-900'}`}
        >
          Contacto
        </a>
      </li>
      <li>
        <a
          href="/contacto/"
          class="btn-enterprise-primary inline-flex items-center justify-center min-h-10 rounded-xl px-4 py-2 text-sm font-semibold"
        >
          Agendar Reunión
        </a>
      </li>
    </ul>
  </div>

  <!-- Mobile Dropdown Panel (toggled via .nav-links.active) -->
  <style>
    @media (max-width: 767px) {
      .nav-links.active {
        display: flex !important;
        position: absolute;
        top: 5rem;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(16px);
        padding: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 20px 25px -5px rgb(12 36 68 / 0.12);
      }
      .nav-links.active a {
        display: block;
        padding: 0.5rem 0.25rem;
        font-size: 1rem;
      }
    }
    header.scrolled {
      height: 4.35rem;
      background-color: rgba(255, 255, 255, 0.96);
      box-shadow: 0 4px 12px -2px rgb(12 36 68 / 0.08);
    }
  </style>
</header>
