---
---

<section id="contacto" class="py-20 bg-slate-50 reveal-block">
  <div class="mx-auto max-w-5xl px-6">
    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl grid grid-cols-1 lg:grid-cols-12">
      <!-- Left Info Panel (Dark Navy) -->
      <div class="lg:col-span-5 bg-navy-900 p-8 sm:p-10 text-white flex flex-col justify-between relative overflow-hidden">
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -right-16 h-52 w-52 rounded-full bg-copper-500/20 blur-2xl"></div>
        <div>
          <span class="inline-block rounded-full bg-copper-500/20 border border-copper-400/30 px-3 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-copper-400 mb-4">
            Conversemos
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-4">
            ¿Listo para optimizar tu negocio?
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
            Agenda una reunión de diagnóstico gratuita para evaluar tus necesidades de analítica, procesos o automatización.
          </p>
        </div>

        <div class="space-y-4 text-sm relative z-10">
          <a href="mailto:contacto@innerdata.cl" class="flex items-center gap-3 text-slate-200 hover:text-copper-400 transition-colors">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-copper-400">
              <i class="fas fa-envelope" aria-hidden="true"></i>
            </span>
            <span class="font-medium">contacto@innerdata.cl</span>
          </a>
          <a href="https://wa.me/56956678642" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-200 hover:text-emerald-400 transition-colors">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-emerald-400">
              <i class="fab fa-whatsapp text-lg" aria-hidden="true"></i>
            </span>
            <span class="font-medium">WhatsApp Directo</span>
          </a>
          <div class="pt-3 border-t border-white/10 flex items-center gap-2 text-xs font-mono text-copper-300">
            <i class="fas fa-clock" aria-hidden="true"></i>
            <span>Respondemos en menos de 24 hrs hábiles</span>
          </div>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="lg:col-span-7 p-8 sm:p-10">
        <form id="contact-form" action="javascript:void(0);" method="post" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="nombre" class="block text-xs font-semibold text-navy-900 mb-1.5">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                required
                class="w-full min-h-11 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-copper-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-copper-500/20"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-navy-900 mb-1.5">Correo Corporativo</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="nombre@empresa.cl"
                required
                class="w-full min-h-11 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-copper-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-copper-500/20"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="empresa_cargo" class="block text-xs font-semibold text-navy-900 mb-1.5">Empresa / Cargo</label>
              <input
                type="text"
                id="empresa_cargo"
                name="empresa_cargo"
                placeholder="Ej. Gerente de Operaciones"
                class="w-full min-h-11 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-copper-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-copper-500/20"
              />
            </div>
            <div>
              <label for="servicio_interes" class="block text-xs font-semibold text-navy-900 mb-1.5">¿En qué área te ayudamos?</label>
              <select
                id="servicio_interes"
                name="servicio_interes"
                class="w-full min-h-11 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 focus:border-copper-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-copper-500/20"
              >
                <option value="Analítica y Ciencia de Datos">Analítica y Ciencia de Datos</option>
                <option value="Control de Gestión y Procesos">Control de Gestión y Procesos</option>
                <option value="Simulación y Optimización">Simulación y Optimización</option>
                <option value="Aplicación Web / Mini ERP">Aplicación Web a Medida</option>
                <option value="Otro">Otro / Diagnóstico General</option>
              </select>
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-xs font-semibold text-navy-900 mb-1.5">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="4"
              placeholder="¿En qué podemos ayudarte?"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-copper-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-copper-500/20"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn-enterprise-primary w-full min-h-12 rounded-xl px-6 py-3 text-sm font-semibold cursor-pointer"
          >
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
