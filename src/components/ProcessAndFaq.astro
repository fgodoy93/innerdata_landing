---
const steps = [
  {
    num: '01',
    title: 'Diagnóstico Gratuito',
    desc: 'Reunión de 30 minutos para entender tu operación, tus datos actuales y el problema prioritario.',
  },
  {
    num: '02',
    title: 'Propuesta con KPIs',
    desc: 'Definimos alcance, plazos cerrados, entregables concretos y métricas de impacto antes de partir.',
  },
  {
    num: '03',
    title: 'Desarrollo Iterativo',
    desc: 'Avances semanales visibles junto a tu equipo en Slack o Teams, validando resultados en cada etapa.',
  },
  {
    num: '04',
    title: 'Entrega y Transferencia',
    desc: 'Capacitamos a tu equipo, documentamos la solución y dejamos soporte post-lanzamiento.',
  },
];

const faqs = [
  {
    q: '¿Cómo protegen la confidencialidad de nuestros datos?',
    a: 'Firmamos acuerdo de confidencialidad (NDA) desde la primera reunión. Trabajamos con accesos mínimos necesarios y buenas prácticas de seguridad en nube y bases de datos.',
  },
  {
    q: '¿Cuánto tarda implementar un proyecto típico?',
    a: 'Un diagnóstico de procesos o dashboard ejecutivo suele tomar entre 2 y 4 semanas; una aplicación web a medida o modelo de simulación/ML entre 3 y 6 semanas según alcance.',
  },
  {
    q: '¿Trabajan de forma remota o presencial en Chile?',
    a: 'Operamos de forma remota con clientes de todo Chile y presencial en terreno cuando el levantamiento de procesos o planta lo requiere.',
  },
  {
    q: '¿Qué pasa después de entregar el sistema o dashboard?',
    a: 'Incluimos acompañamiento post-entrega, documentación técnica y capacitación para que tu equipo pueda operar con autonomía o escalar nuevas funcionalidades.',
  },
];
---

<section class="py-20 bg-white border-b border-slate-200 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Cómo Trabajamos -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 border-b border-slate-200 mb-10">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-2">
          04 — Metodología
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900">
          Cómo trabajamos contigo
        </h2>
      </div>
      <p class="text-slate-600 text-sm sm:text-base max-w-md">
        Un proceso claro, sin burocracia y orientado a entregar valor medible desde las primeras semanas.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border border-slate-200 bg-slate-200 gap-px mb-16">
      {steps.map((s) => (
        <div class="bg-white p-6 sm:p-7">
          <span class="font-mono text-xs font-bold text-copper-500 block mb-4">PASO {s.num}</span>
          <h3 class="font-display text-lg font-bold text-navy-900 mb-2">{s.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- FAQ -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-4">
      <div class="lg:col-span-4">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-copper-500 block mb-2">
          Preguntas Frecuentes
        </span>
        <h3 class="font-display text-2xl font-extrabold text-navy-900 mb-3">
          Resolvemos tus dudas antes de partir
        </h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Transparencia en plazos, resguardo de información y soporte técnico desde el primer día.
        </p>
      </div>

      <div class="lg:col-span-8 border-t border-slate-200 divide-y divide-slate-200">
        {faqs.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-navy-900 hover:text-copper-600 transition-colors">
              <span>{item.q}</span>
              <span class="font-mono text-sm text-copper-500 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
            </summary>
            <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed pr-6">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
