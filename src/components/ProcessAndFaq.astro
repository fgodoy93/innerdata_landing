---
const steps = [
  {
    num: '01',
    title: 'Diagnóstico Gratuito',
    desc: 'Reunión de 30 minutos para entender tu operación, tus datos actuales y el problema prioritario a resolver.',
  },
  {
    num: '02',
    title: 'Propuesta con KPIs',
    desc: 'Definimos alcance, plazos cerrados, entregables concretos y métricas de impacto antes de partir.',
  },
  {
    num: '03',
    title: 'Desarrollo Iterativo',
    desc: 'Avances semanales visibles junto a tu equipo en Slack o Teams, validando resultados en cada etapa.',
  },
  {
    num: '04',
    title: 'Entrega y Transferencia',
    desc: 'Capacitamos a tu equipo, documentamos la solución y dejamos soporte post-lanzamiento.',
  },
];

const faqs = [
  {
    q: '¿Cómo protegen la confidencialidad de nuestros datos?',
    a: 'Firmamos acuerdo de confidencialidad (NDA) desde la primera reunión. Trabajamos con accesos mínimos necesarios y buenas prácticas de seguridad en nube y bases de datos.',
  },
  {
    q: '¿Cuánto tarda implementar un proyecto típico?',
    a: 'Un diagnóstico de procesos o dashboard ejecutivo suele tomar entre 2 y 4 semanas; una aplicación web a medida o modelo de simulación/ML entre 3 y 6 semanas según alcance.',
  },
  {
    q: '¿Trabajan de forma remota o presencial en Chile?',
    a: 'Operamos de forma remota con clientes de todo Chile y presencial en terreno cuando el levantamiento de procesos o planta lo requiere.',
  },
  {
    q: '¿Qué pasa después de entregar el sistema o dashboard?',
    a: 'Incluimos acompañamiento post-entrega, documentación técnica y capacitación para que tu equipo pueda operar con autonomía o escalar nuevas funcionalidades.',
  },
];
---

<section class="py-20 bg-slate-50 border-t border-slate-200 reveal-block">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Cómo Trabajamos -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block rounded-full bg-copper-500/10 border border-copper-500/25 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-copper-500 mb-3">
        Metodología
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-navy-900 mb-3">
        Cómo trabajamos contigo
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Un proceso claro, sin burocracia y orientado a entregar valor medible desde las primeras semanas.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-20">
      {steps.map((s) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-md">
          <span class="font-mono text-2xl font-extrabold text-copper-500 block mb-3">{s.num}</span>
          <h3 class="font-display text-lg font-bold text-navy-900 mb-2">{s.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- FAQ -->
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <span class="inline-block rounded-full bg-navy-900/5 border border-navy-900/15 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-navy-900 mb-2">
          Preguntas Frecuentes
        </span>
        <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900">
          Resolvemos tus dudas antes de partir
        </h3>
      </div>

      <div class="space-y-3">
        {faqs.map((item) => (
          <details class="group rounded-2xl border border-slate-200 bg-white px-6 py-4 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-navy-900">
              <span>{item.q}</span>
              <i class="fas fa-chevron-down text-xs text-copper-500 transition-transform duration-200 group-open:rotate-180 shrink-0" aria-hidden="true"></i>
            </summary>
            <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
