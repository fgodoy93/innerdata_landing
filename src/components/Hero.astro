---
const featuredCases = [
  { name: 'Aukabox', scope: 'Web App · Next.js', metric: 'Miami → Chile', href: '/portafolio/aukabox/' },
  { name: 'Mini ERP PyMEs', scope: 'Flujo de Caja · SII', metric: '0 hrs cierre', href: '/portafolio/mini-erp/' },
  { name: 'Urgencias SAR', scope: 'Simulación · SIMIO 10', metric: '-50–75% espera', href: '/portafolio/simulacion/' },
  { name: 'Pesquera ASG', scope: 'Sostenibilidad · Hídrica', metric: '15+ KPIs', href: '/portafolio/pesquera/' },
  { name: 'Fondos AFP', scope: 'Series de Tiempo · Python', metric: '0.95 corr. S&P', href: '/portafolio/pensiones/' },
];
---

<section
  id="inicio"
  class="relative min-h-[720px] lg:min-h-[780px] flex items-center overflow-hidden bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-28 pb-20 text-white"
>
  <!-- Interactive Particles Background (preserved) -->
  <div id="particles-js" class="absolute inset-0 z-[1]"></div>

  <!-- Subtle Copper & Navy Radial Depth -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(circle_at_75%_25%,rgba(200,117,51,0.16)_0%,transparent_50%)]"
  ></div>

  <div class="relative z-10 mx-auto max-w-6xl w-full px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Institutional Messaging & Typing Animation -->
      <div class="lg:col-span-7">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-copper-400 mb-5">
          Consultoría en Ingeniería, Datos &amp; Software · Chile
        </p>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.05] mb-5">
          InnerData
          <span class="sr-only"> — Consultoría en Analítica Avanzada, Ciencia de Datos, Optimización de Procesos y Desarrollo Web en Chile</span>
        </h1>

        <p class="text-xl sm:text-2xl font-semibold text-copper-gradient mb-6 leading-snug">
          Transformamos <span id="typing-text" class="typing-caret font-bold text-copper-400">la complejidad</span> en ventaja competitiva
        </p>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl mb-9">
          Automatizamos tus reportes, optimizamos tus procesos con simulación y desarrollamos aplicaciones web a medida para hacer más rentable tu operación.
        </p>

        <div class="flex flex-col sm:flex-row gap-3.5">
          <a
            href="/contacto/"
            class="group btn-enterprise-primary inline-flex items-center justify-center gap-2.5 min-h-12 rounded-lg px-7 py-3.5 text-sm sm:text-base font-semibold"
          >
            Hablemos
            <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
          <a
            href="/servicios/"
            class="inline-flex items-center justify-center gap-2 min-h-12 rounded-lg border border-white/25 bg-transparent px-7 py-3.5 text-sm sm:text-base font-semibold text-white transition-colors hover:bg-white hover:text-navy-900"
          >
            Explorar Servicios
          </a>
        </div>
      </div>

      <!-- Right Column: Swiss Technical Case Index (real links & metrics) -->
      <div class="lg:col-span-5">
        <div class="rounded-xl border border-white/15 bg-navy-950/75 backdrop-blur-md overflow-hidden">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-slate-300">
              Índice de Casos Publicados
            </span>
            <span class="font-mono text-[11px] text-copper-400">05 Proyectos</span>
          </div>

          <ul class="divide-y divide-white/10">
            {featuredCases.map((item, idx) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between gap-4 px-5 py-3.5 transition-colors hover:bg-white/[0.06]"
                >
                  <div class="min-w-0">
                    <div class="flex items-center gap-2.5">
                      <span class="font-mono text-[11px] text-slate-500">0{idx + 1}</span>
                      <span class="font-display text-sm font-bold text-white group-hover:text-copper-400 transition-colors truncate">
                        {item.name}
                      </span>
                    </div>
                    <p class="font-mono text-[11px] text-slate-400 pl-6 truncate">{item.scope}</p>
                  </div>
                  <div class="flex items-center gap-2.5 shrink-0">
                    <span class="font-mono text-xs font-semibold text-copper-300">{item.metric}</span>
                    <i class="fas fa-arrow-right text-[10px] text-slate-500 group-hover:text-copper-400 group-hover:translate-x-0.5 transition-all" aria-hidden="true"></i>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <div class="border-t border-white/10 px-5 py-3 bg-white/[0.03] flex items-center justify-between">
            <span class="font-mono text-[11px] text-slate-400">Todos los casos documentados</span>
            <a href="/portafolio/" class="font-mono text-xs font-semibold text-copper-400 hover:text-copper-300 transition-colors">
              Ver portafolio →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
