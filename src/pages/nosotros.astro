---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyBento from '../components/WhyBento.astro';
import Footer from '../components/Footer.astro';

const industries = [
  { icon: 'fa-boxes-stacked', name: 'Logística & Courier', desc: 'Casillas internacionales, ruteo y trazabilidad.' },
  { icon: 'fa-industry', name: 'Pesquero-Industrial', desc: 'Indicadores ASG, huella hídrica y procesos.' },
  { icon: 'fa-hospital-user', name: 'Salud Pública', desc: 'Simulación de flujos y reducción de esperas.' },
  { icon: 'fa-chart-pie', name: 'Finanzas & PyMEs', desc: 'Control de flujo de caja, BI y series de tiempo.' },
];
---

<BaseLayout
  title="Nosotros | Socios en Ingeniería y Datos - InnerData"
  description="Conoce a InnerData: ingenieros y científicos de datos resolviendo problemas críticos de negocio en Chile con rigor técnico y confidencialidad."
>
  <Navbar currentPage="about" />

  <main class="flex-1 bg-slate-50 pt-20">
    <AboutSection />

    <!-- Industrias Atendidas -->
    <section class="py-16 bg-white border-b border-slate-200 reveal-block">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-block rounded-full bg-copper-500/10 border border-copper-500/25 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-copper-500 mb-3">
            Experiencia Sectorial
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900">
            Industrias donde ya generamos impacto
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {industries.map((ind) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 transition-all hover:-translate-y-1 hover:shadow-md hover:border-copper-500/35">
              <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-navy-900 text-copper-400">
                <i class={`fas ${ind.icon}`} aria-hidden="true"></i>
              </span>
              <h3 class="font-display text-base font-bold text-navy-900 mb-1.5">{ind.name}</h3>
              <p class="text-sm text-slate-600">{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <WhyBento />
  </main>

  <Footer isHome={false} />
</BaseLayout>
