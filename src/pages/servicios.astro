---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ServicesBento from '../components/ServicesBento.astro';
import TechStackBar from '../components/TechStackBar.astro';
import ProcessAndFaq from '../components/ProcessAndFaq.astro';
import ServiceModals from '../components/ServiceModals.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Servicios | Analítica, Procesos, Simulación y Software - InnerData"
  description="Soluciones integrales en Ciencia de Datos, Control de Gestión, Simulación con SIMIO y Desarrollo de Aplicaciones Web a medida en Chile."
>
  <Navbar currentPage="services" />

  <main class="flex-1 bg-slate-50 pt-20">
    <ServicesBento />
    <TechStackBar />
    <ProcessAndFaq />
  </main>

  <Footer isHome={false} />
  <ServiceModals />
</BaseLayout>
